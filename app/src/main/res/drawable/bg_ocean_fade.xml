<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="800dp"
    android:viewportWidth="360"
    android:viewportHeight="800">

    <!-- 1. TIERRA: Fondo neutro estilo papel de mapa continental -->
    <path
        android:pathData="M0,0 L360,0 L360,800 L0,800 Z"
        android:fillColor="#F4F1EA" />

    <!-- 2. OCÉANO: Gradiente azul suave en la costa oeste -->
    <path
        android:pathData="
            M0,0
            L120,0
            L100,90
            L118,180
            L95,260
            L112,340
            L88,420
            L105,500
            L82,580
            L98,660
            L75,740
            L90,800
            L0,800 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="130"
                android:endY="0"
                android:startColor="#B2D2E8"
                android:endColor="#E3F0F8" />
        </aapt:attr>
    </path>

    <!-- 3. LÍNEA DE COSTA / OLA CONTINENTAL (Contorno del mar) -->
    <path
        android:pathData="M120,0 L100,90 L118,180 L95,260 L112,340 L88,420 L105,500 L82,580 L98,660 L75,740 L90,800"
        android:strokeColor="#74A9C9"
        android:strokeWidth="1.5" />

    <!-- 4. LÍNEAS TOPOGRÁFICAS / ISOÍPSAS (Efecto relieve sutil) -->
    <path
        android:pathData="M135,0 C110,120 130,220 105,340 C90,420 120,520 95,640 C85,710 105,800 105,800"
        android:strokeColor="#10000000"
        android:strokeWidth="1" />
    <path
        android:pathData="M150,0 C125,120 145,220 120,340 C105,420 135,520 110,640 C100,710 120,800 120,800"
        android:strokeColor="#0B000000"
        android:strokeWidth="1" />

    <!-- 5. GRILLA CARTOGRÁFICA DE COORDENADAS (Paralelos y Meridianos) -->
    <!-- Líneas Verticales (Meridianos) -->
    <path
        android:pathData="M60,0 V800 M120,0 V800 M180,0 V800 M240,0 V800 M300,0 V800"
        android:strokeColor="#0D000000"
        android:strokeWidth="1" />
    <!-- Líneas Horizontales (Paralelos) -->
    <path
        android:pathData="M0,100 H360 M0,200 H360 M0,300 H360 M0,400 H360 M0,500 H360 M0,600 H360 M0,700 H360"
        android:strokeColor="#0D000000"
        android:strokeWidth="1" />

    <!-- 6. DETALLE CARTOGRÁFICO: Simbolo de Norte / Rosa de los Vientos (Arriba Derecha) -->
    <group
        android:translateX="300"
        android:translateY="80">
        <!-- Círculo Exterior -->
        <path
            android:pathData="M 0,-22 A 22,22 0 1,1 -0.01,-22"
            android:strokeColor="#1F000000"
            android:strokeWidth="1" />
        <!-- Aguja Norte -->
        <path
            android:pathData="M0,0 L0,-18 L5,0 Z"
            android:fillColor="#30000000" />
        <path
            android:pathData="M0,0 L0,-18 L-5,0 Z"
            android:fillColor="#15000000" />
        <!-- Aguja Sur, Este, Oeste -->
        <path
            android:pathData="M0,0 L0,14 L3,0 Z M0,0 L14,0 L0,3 Z M0,0 L-14,0 L0,-3 Z"
            android:fillColor="#15000000" />
    </group>

</vector>