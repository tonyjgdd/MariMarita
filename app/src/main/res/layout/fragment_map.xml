<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= 1. FONDO AZUL DEGRADADO (respaldo detrás del mapa) ================= -->
    <View
        android:id="@+id/vOceanBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_ocean_fade"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= 2. MAPA A PANTALLA COMPLETA ================= -->
    <com.app.tmarita.view.PeruMapView
        android:id="@+id/peruMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ================= 3. HEADER FLOTANTE ================= -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Título: tamaño ideal, sin weight -->
        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:adjustViewBounds="true"
            android:src="@drawable/titulo8"
            android:contentDescription="@string/app_name" />

        <!-- Panda: al lado inmediato del título -->
        <ImageView
            android:id="@+id/ivHeaderPanda"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_sf"
            android:contentDescription="@string/app_name" />

    </LinearLayout>
    <!-- ================= 4. CARD DE PROGRESO (flota debajo del header) ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="@color/cream"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ya conocemos"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:minLines="2"
                android:maxLines="2"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="8 / 24 Departamentos"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/progressPercentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="33%"
                    android:textColor="@color/splash_pink"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="24"
                android:progress="8"
                android:progressTint="@color/splash_pink"
                android:progressBackgroundTint="@color/accent_track"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ================= 5. BOTÓN FLOTANTE BRÚJULA ================= -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnLocateMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_compass"
        android:contentDescription="Centrar mapa"
        app:backgroundTint="@color/cream"
        app:tint="@color/ink"
        app:fabSize="normal"
        app:elevation="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar"/>

    <!-- ================= 6. TARJETA FLOTANTE DE REGIÓN (con imagen de fondo) ================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/regionInfoCard"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:cardCornerRadius="18dp"
        app:cardElevation="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Imagen de fondo, distinta por cada departamento -->
            <ImageView
                android:id="@+id/regionBackgroundImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Scrim: oscurece la parte donde va el texto, para que siempre se lea bien -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_region_scrim" />

            <!-- Contenido: texto blanco + botón, encima de la imagen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/regionNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Cusco"
                        android:textColor="@color/cream"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"/>

                    <TextView
                        android:id="@+id/regionStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Aún no visitado"
                        android:textColor="@color/cream"
                        android:alpha="0.9"
                        android:textSize="12sp"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenRegion"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abrir"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/accent" />

            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>



    <!-- ================= 7. BARRA INFERIOR FLOTANTE ================= -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_floating_panel"
        android:clipToOutline="true"
        android:elevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnNavRecuerdos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_imagen"
                app:tint="@color/ink_soft"
                android:contentDescription="Recuerdos"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Recuerdos"
                android:textColor="@color/ink_soft"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavEstadisticas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_estadistica"
                app:tint="@color/ink_soft"
                android:contentDescription="Estadísticas"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Estadísticas"
                android:textColor="@color/ink_soft"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>