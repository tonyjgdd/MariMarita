<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_pink">

    <!-- Guideline: las fotos ocupan 2/3 de pantalla (0.667), el panel sólido el 1/3 final -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidePhotoEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.60"/>

    <!-- Foto de fondo, ocupa 2/3 superiores -->
    <ImageView
        android:id="@+id/ivPhotoA"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guidePhotoEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivPhotoB"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guidePhotoEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Degradado: funde el borde inferior de la foto hacia el rosa sólido, justo antes del guide -->
    <View
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:background="@drawable/scrim_splash"
        app:layout_constraintBottom_toBottomOf="@id/guidePhotoEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--
        Panda superpuesto al borde del degradado: mitad sobre la foto, mitad sobre
        el rosa sólido. Se logra centrando su top en el guide y subiéndolo con
        translationY negativo (mitad de su alto, aprox.).
    -->
    <ImageView
        android:id="@+id/ivPanda"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/logo_sf"
        android:contentDescription="Logo"
        android:translationY="-90dp"
        app:layout_constraintTop_toTopOf="@id/guidePhotoEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Título pegado justo debajo del panda -->
    <ImageView
        android:id="@+id/tvTitle"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-120dp"
        android:adjustViewBounds="true"
        android:src="@drawable/titulo2"
        app:layout_constraintTop_toBottomOf="@id/ivPanda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Subtítulo pegado justo debajo del título -->
    <!-- Comilla -->
    <ImageView
        android:id="@+id/ivQuote"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/comilla"
        android:scaleY="-1"
        android:scaleX="-1"
        android:contentDescription="@null"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/tvSubtitles"/>

    <!-- Subtítulo -->
    <!-- Contenedor del subtítulo + corazón -->
    <LinearLayout
        android:id="@+id/tvSubtitles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cada viaje, un recuerdo juntos"
            android:textColor="#DDFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <!-- Corazón -->
        <ImageView
            android:id="@+id/imgHeart"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/heard"
            android:contentDescription="Corazón"/>

    </LinearLayout>

    <!--
        Progress bar y "Cargando..." NO se conectan al subtítulo: quedan anclados
        al fondo de la pantalla, dejando el hueco libre grande que se ve en la
        referencia entre el subtítulo y ellos.
    -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginBottom="14dp"
        android:indeterminate="true"
        android:indeterminateTint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/tvLoading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:id="@+id/tvLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="Cargando..."
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>