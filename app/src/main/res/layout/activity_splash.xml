<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Título -->
    <ImageView
        android:id="@+id/ivTitle"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:adjustViewBounds="true"
        android:src="@drawable/titulo2"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Frase, debajo del título -->
    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:textStyle="bold|italic"
        android:textColor="#DDFFFFFF"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toBottomOf="@id/ivTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Footer -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Designed by TonyG ️"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Collage 3x3 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/collageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuote"
        app:layout_constraintBottom_toTopOf="@id/tvFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto1" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="0" app:layout_constraintVertical_bias="0"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto1"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto2" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintVertical_bias="0"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto2"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto3" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="1" app:layout_constraintVertical_bias="0"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto3"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto4" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="0" app:layout_constraintVertical_bias="0.5"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto4"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto5" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintVertical_bias="0.5"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto5"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto6" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="1" app:layout_constraintVertical_bias="0.5"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto6"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto7" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="0" app:layout_constraintVertical_bias="1"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto7"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto8" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintVertical_bias="1"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto8"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/foto9" android:scaleType="centerCrop" android:layout_margin="2dp"
            android:layout_width="0dp" android:layout_height="0dp"
            app:shapeAppearanceOverlay="@style/RoundedCorners"
            app:layout_constraintWidth_percent="0.334" app:layout_constraintHeight_percent="0.334"
            app:layout_constraintHorizontal_bias="1" app:layout_constraintVertical_bias="1"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto9"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay de color uniforme sobre el grid completo -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#4D0C1633"
        app:layout_constraintTop_toTopOf="@id/collageContainer"
        app:layout_constraintBottom_toBottomOf="@id/collageContainer"
        app:layout_constraintStart_toStartOf="@id/collageContainer"
        app:layout_constraintEnd_toEndOf="@id/collageContainer"/>

</androidx.constraintlayout.widget.ConstraintLayout>