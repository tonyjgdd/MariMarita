<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <!-- Título de la app: fijo arriba, con su propio espacio -->
    <ImageView
        android:id="@+id/ivTitle"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:adjustViewBounds="true"
        android:src="@drawable/titulo"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Footer: fijo abajo -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Designed by TonyG ️"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Contenedor del collage: ahora vive ENTRE el título y el footer, no de borde a borde -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/collageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/ivTitle"
        app:layout_constraintBottom_toTopOf="@id/tvFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView android:id="@+id/foto1" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.387" app:layout_constraintHeight_percent="0.183"
            app:layout_constraintHorizontal_bias="0.034" app:layout_constraintVertical_bias="0.019"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto1"/>

        <ImageView android:id="@+id/foto2" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.548" app:layout_constraintHeight_percent="0.356"
            app:layout_constraintHorizontal_bias="0.947" app:layout_constraintVertical_bias="0.024"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto2"/>

        <ImageView android:id="@+id/foto3" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.387" app:layout_constraintHeight_percent="0.159"
            app:layout_constraintHorizontal_bias="0.034" app:layout_constraintVertical_bias="0.252"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto3"/>

        <ImageView android:id="@+id/foto4" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.174" app:layout_constraintHeight_percent="0.215"
            app:layout_constraintHorizontal_bias="0.971" app:layout_constraintVertical_bias="0.487"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto4"/>

        <ImageView android:id="@+id/foto5" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.201" app:layout_constraintHeight_percent="0.216"
            app:layout_constraintHorizontal_bias="0.026" app:layout_constraintVertical_bias="0.492"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto5"/>

        <ImageView android:id="@+id/foto6" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.560" app:layout_constraintHeight_percent="0.371"
            app:layout_constraintHorizontal_bias="0.048" app:layout_constraintVertical_bias="0.976"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto6"/>

        <ImageView android:id="@+id/foto7" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.371" app:layout_constraintHeight_percent="0.162"
            app:layout_constraintHorizontal_bias="0.962" app:layout_constraintVertical_bias="0.733"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto7"/>

        <ImageView android:id="@+id/foto8" android:scaleType="centerCrop"
            android:layout_width="0dp" android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.371" app:layout_constraintHeight_percent="0.192"
            app:layout_constraintHorizontal_bias="0.962" app:layout_constraintVertical_bias="0.974"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/foto8"/>

        <!-- Frase, ahora dentro del collage para que su guideline sea relativa a este espacio -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideTextTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.46"/>

        <TextView
            android:id="@+id/tvQuote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="90dp"
            android:layout_marginEnd="90dp"
            android:gravity="center"
            android:textStyle="bold|italic"
            android:textColor="#EEFFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            app:layout_constraintTop_toTopOf="@id/guideTextTop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>