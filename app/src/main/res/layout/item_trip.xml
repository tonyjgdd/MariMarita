<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke"
    app:rippleColor="@color/splash_pink_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== FOTO ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <ImageView
                android:id="@+id/ivTripPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_photo_top_scrim" />

            <TextView
                android:id="@+id/tvTripDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="12 ago 2026"
                android:textColor="@android:color/white"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- ELIMINAR: círculo blanco flotante, solo en su esquina -->
            <ImageButton
                android:id="@+id/btnTripDelete"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_button_white"
                android:padding="7dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/ink"
                android:contentDescription="Eliminar viaje" />

        </FrameLayout>

        <!-- ===== CONTENIDO ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Fila: nombre del lugar + botón "Ver fotos" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTripPlace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="17sp"
                    android:textColor="@color/ink"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Cañón del Colca" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTripDrive"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Ver fotos"
                    android:textSize="11.5sp"
                    android:textColor="@color/splash_pink"
                    app:icon="@drawable/ic_imagen"
                    app:iconSize="14dp"
                    app:iconTint="@color/splash_pink"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:strokeColor="@color/splash_pink"
                    app:strokeWidth="1.2dp"
                    app:cornerRadius="17dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTripNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13.5sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ink_soft"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Notas del viaje" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>