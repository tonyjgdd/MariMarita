<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/card"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Contenedor circular para el ícono, ahora más grande -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_sf"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/ink"
            android:textStyle="bold"
            android:textSize="17sp"
            android:lineSpacingExtra="2dp"
            android:gravity="center"
            tools:text="Título del mensaje" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:gravity="center"
            tools:text="Descripción del mensaje" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/card"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            app:backgroundTint="@color/splash_pink"
            tools:text="Aceptar" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>